  <circuit name="Branch_Control">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Branch_Control"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(1070,150)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="PCWriteFinal"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="0" loc="(200,170)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="PCWrite"/>
    </comp>
    <comp lib="0" loc="(200,220)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="PCWriteCond"/>
    </comp>
    <comp lib="0" loc="(200,270)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="IsBeq"/>
    </comp>
    <comp lib="0" loc="(200,320)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="IsBne"/>
    </comp>
    <comp lib="0" loc="(200,370)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Zero"/>
    </comp>
    <comp lib="0" loc="(240,170)" name="Tunnel">
      <a name="label" val="PCWrite"/>
    </comp>
    <comp lib="0" loc="(860,130)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="PCWrite"/>
    </comp>
    <comp lib="1" loc="(1000,150)" name="OR Gate"/>
    <comp lib="1" loc="(430,270)" name="NOT Gate"/>
    <comp lib="1" loc="(520,190)" name="AND Gate"/>
    <comp lib="1" loc="(520,290)" name="AND Gate"/>
    <comp lib="1" loc="(650,210)" name="OR Gate"/>
    <comp lib="1" loc="(800,370)" name="AND Gate"/>
    <comp lib="7" loc="(1160,100)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text">PCWriteFinal | 1 bit (Va directamente a la habilitación de carga Enable del registro PC en el Datapath)
</a>
    </comp>
    <comp lib="7" loc="(225,50)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text">PCWrite | 1 bit (Viene de la FSM: 1 indica que hay que escribir el PC obligatoriamente)
PCWriteCond | 1 bit (Viene de la FSM: 1 indica que estamos evaluando un branch)
IsBeq | 1 bit (Viene del Decoder: 1 si es beq)
IsBne | 1 bit (Viene del Decoder: 1 si es bne)
Zero | 1 bit (Viene de la ALU: 1 si la resta de $rs - $rt dio 0)
</a>
    </comp>
    <comp lib="7" loc="(345,570)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text">Lógica BEQ: BeqTaken = IsBeq AND Zero 
Lógica BNE: BneTaken = IsBne AND (NOT Zero) 
Branch Tomado: BranchTaken = BeqTaken OR BneTaken
Condición de Salto: BranchWrite = PCWriteCond AND BranchTaken 
Decisión Final: PCWriteFinal=PCWrite OR BranchWrite</a>
    </comp>
    <comp lib="7" loc="(470,145)" name="Text">
      <a name="text" val="BeqTaken"/>
    </comp>
    <comp lib="7" loc="(490,255)" name="Text">
      <a name="text" val="BneTaken"/>
    </comp>
    <comp lib="7" loc="(635,175)" name="Text">
      <a name="text" val="BranchTaken"/>
    </comp>
    <comp lib="7" loc="(770,330)" name="Text">
      <a name="text" val="BranchWrite"/>
    </comp>
